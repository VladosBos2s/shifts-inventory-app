model WashProgram {
  id           String              @id @default(cuid())
  name         String
  price        Int
  foamUsage    Int                 @default(0) @map("foam_usage")
  transactions Transaction[]
  consumables  ProgramConsumable[]

  @@map("wash_programs")
}

model Transaction {
  id            String      @id @default(uuid())
  shiftId       String
  programId     String
  amount        Int         // Total price in base currency (e.g., cents)
  paymentMethod String      @default("CASH") // CASH, CARD, BLIK
  createdAt     DateTime    @default(now())

  shift         Shift       @relation(fields: [shiftId], references: [id])
  program       WashProgram @relation(fields: [programId], references: [id])

  @@map("transactions")
}

model Inventory {
    id String @id @default(cuid())
    name String // Example: 'Active foam'
    quantity Int // Current stock in ml
    unit String @default("ml")
    minStockLimit Int      @default(2000) // Alert threshold (e.g., 2 liters)
    updatedAt     DateTime @updatedAt
    programs      ProgramConsumable[]

  @@map("inventories")

}

model ProgramConsumable {
  id          String      @id @default(cuid())
  programId   String
  inventoryId String
  quantity    Int         

  program     WashProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  inventory   Inventory   @relation(fields: [inventoryId], references: [id])

  @@map("program_consumables")
}